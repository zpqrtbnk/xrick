  <!-- T19 native-build fix: common settings shared by all four configs, merged with
       %(...) so the per-config blocks below can still add their own. Previously only
       Debug|Win32 set AdditionalIncludeDirectories/PreprocessorDefinitions at all,
       so the three other configs had no path to include\*.h, which is why they
       could never compile. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>include;vcpkg_installed\$(VcpkgTriplet)\include;vcpkg_installed\$(VcpkgTriplet)\include\SDL2;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- SDL_MAIN_HANDLED: SDL_main.h renames main() to SDL_main() on Windows unless
           told otherwise, which otherwise leaves xrick.c's own main() with no real
           main symbol to link against (found via LNK2001 on the first native build,
           2026-09-10). The Linux/Makefile build never hits this since SDL_main.h's
           renaming is Windows/WinRT/iOS/Android-only. -->
      <PreprocessorDefinitions>_MBCS;_CRT_SECURE_NO_WARNINGS;SDL_MAIN_HANDLED;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>vcpkg_installed\$(VcpkgTriplet)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL2.lib;z.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <!-- T19 native-build fix: SDL2.dll/z.dll are vcpkg's dynamic-triplet runtime
         deps and don't get auto-deployed here (that needs VcpkgEnabled's own
         targets import, which this project doesn't pull in), so copy them next to
         the exe explicitly on every build. -->
    <PostBuildEvent>
      <Command>copy /Y "$(ProjectDir)vcpkg_installed\$(VcpkgTriplet)\bin\SDL2.dll" "$(OutDir)" &gt;nul
copy /Y "$(ProjectDir)vcpkg_installed\$(VcpkgTriplet)\bin\z.dll" "$(OutDir)" &gt;nul</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
